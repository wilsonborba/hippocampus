# Hippocampus Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Database configuration (defaults to SQLite local; use postgresql+psycopg://... in production)
HIPPOCAMPUS_DATABASE_URL=sqlite:///var/hippocampus.db

# Redis: transient working memory / cache. Optional — Hippocampus degrades
# gracefully (in-memory fallback) when unset or unreachable.
HIPPOCAMPUS_REDIS_URL=

# CouchDB: durable flexible MemoryDocument storage. Optional — Hippocampus
# degrades gracefully (structured-only memories) when unset or unreachable.
HIPPOCAMPUS_COUCHDB_URL=
HIPPOCAMPUS_COUCHDB_DATABASE=hippocampus
HIPPOCAMPUS_COUCHDB_USERNAME=
HIPPOCAMPUS_COUCHDB_PASSWORD=

# File Store: existing local large/raw artifact service (reference only).
HIPPOCAMPUS_FILESTORE_URL=
HIPPOCAMPUS_FILESTORE_API_KEY=
HIPPOCAMPUS_FILESTORE_TIMEOUT_SECONDS=10

# Embedding provider (optional; semantic search degrades gracefully when unset)
HIPPOCAMPUS_EMBEDDING_PROVIDER=none
HIPPOCAMPUS_EMBEDDING_MODEL=
HIPPOCAMPUS_OLLAMA_BASE_URL=http://localhost:11434

# Server configuration
HIPPOCAMPUS_API_HOST=127.0.0.1
HIPPOCAMPUS_API_PORT=8001
HIPPOCAMPUS_CORS_ALLOW_ORIGINS=["*"]

# Logging
HIPPOCAMPUS_LOG_LEVEL=INFO
HIPPOCAMPUS_LOG_FILE=var/hippocampus.log

# Environment (development, test, production)
HIPPOCAMPUS_ENVIRONMENT=development

# Recall/search tuning
HIPPOCAMPUS_RECALL_DEFAULT_LIMIT=10
HIPPOCAMPUS_RECALL_MAX_LIMIT=50
HIPPOCAMPUS_GRAPH_MAX_DEPTH=2

# API authentication. Empty = disabled (local/dev mode, current default).
# {"service-name": "static-bearer-key", ...} — same shape as FSM's FSM_APP_KEYS.
HIPPOCAMPUS_API_KEYS={}
# Service names (from HIPPOCAMPUS_API_KEYS) allowed to call destructive
# operations such as hard delete.
HIPPOCAMPUS_ADMIN_SERVICES=[]

# Consolidation: candidate sets are always bounded, never "everything".
HIPPOCAMPUS_CONSOLIDATION_MAX_CANDIDATES=50

# Background job scheduler (`hippocampus scheduler run`)
HIPPOCAMPUS_SCHEDULER_ENABLED=true
HIPPOCAMPUS_SCHEDULER_EXPIRATION_INTERVAL_SECONDS=300
HIPPOCAMPUS_SCHEDULER_DOCUMENT_SYNC_INTERVAL_SECONDS=120
HIPPOCAMPUS_SCHEDULER_EMBEDDING_INTERVAL_SECONDS=60
HIPPOCAMPUS_SCHEDULER_RECONCILIATION_INTERVAL_SECONDS=1800
