# Hippocampus Environment Configuration Template
# Copy this file to .env and adjust variables as needed
#
# Only secrets and environment-specific private values belong here (which
# host/credential this deployment points at). Anything that tunes app
# behavior (recall weights, limits, scheduler intervals, log level, ...)
# lives in lib/core/settings.py as a code default instead — see
# AI_AGENT_Working_Rules.md.

# Database (defaults to SQLite local; use postgresql+psycopg://... in production)
HIPPOCAMPUS_DATABASE_URL=sqlite:///var/hippocampus.db

# Redis: transient working memory / cache. Optional — Hippocampus degrades
# gracefully (in-memory fallback) when unset or unreachable.
HIPPOCAMPUS_REDIS_URL=

# CouchDB: durable flexible MemoryDocument storage. Optional — Hippocampus
# degrades gracefully (structured-only memories) when unset or unreachable.
HIPPOCAMPUS_COUCHDB_URL=
HIPPOCAMPUS_COUCHDB_USERNAME=
HIPPOCAMPUS_COUCHDB_PASSWORD=

# File Store (FSM): existing local large/raw artifact service.
HIPPOCAMPUS_FILESTORE_URL=
HIPPOCAMPUS_FILESTORE_API_KEY=

# Local embedding provider, if any (e.g. Ollama running elsewhere on the LAN).
HIPPOCAMPUS_OLLAMA_BASE_URL=http://localhost:11434

# Which interface/port this instance listens on.
HIPPOCAMPUS_API_HOST=127.0.0.1
HIPPOCAMPUS_API_PORT=8001

# API authentication. Empty = disabled (local/dev mode, current default).
# {"service-name": "static-bearer-key", ...} — same shape as FSM's FSM_APP_KEYS.
HIPPOCAMPUS_API_KEYS={}
# Service names (from HIPPOCAMPUS_API_KEYS) allowed to call destructive
# operations such as hard delete. Which identities exist/are trusted is
# itself deployment-specific, not application behavior.
HIPPOCAMPUS_ADMIN_SERVICES=[]
